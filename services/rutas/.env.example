# Puerto para desarrollo local
PORT=3001

# Cadena de conexión de Supabase (Connect → Transaction pooler, puerto 6543)
DATABASE_URL=postgresql://postgres.<ref>:<contraseña>@aws-1-us-west-2.pooler.supabase.com:6543/postgres

# Clave que comparten Rutas y Reservas para ocupar y liberar cupos.
# Generarla con: openssl rand -hex 32
CLAVE_INTERNA=

# Orígenes que pueden llamar a la API, separados por coma. "*" permite todos.
ORIGENES_PERMITIDOS=http://localhost:5173
